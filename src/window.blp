using Gtk 4.0;
using Adw 1;

template $IdentitiesWindow : Adw.ApplicationWindow {
  title: "Identities";
  default-height: 450;
  default-width: 800;
  Adw.Breakpoint {
    condition ("max-width: 550sp")
    setters {
      splitview.collapsed: true;
    }
  }
  content: welcome;
}

Adw.NavigationSplitView splitview {
  //collapsed: false;
  //show-content: false;
  sidebar: password_browser;
  content: password_viewer_navigation;
}

Adw.ToolbarView welcome {
  [top]
  Adw.HeaderBar {
    show-title: false;
    [end]
    Gtk.MenuButton {
      primary: true;
      icon-name: "open-menu-symbolic";
      tooltip-text: _("Menu");
      menu-model: primary_menu;
    }
  }
  content: Adw.StatusPage {
    title: "Welcome to Identities!";
    description: "The standard unix password manager for GNOME";
    child: Adw.Clamp {
      maximum-size: 250;
      child: Gtk.Button start {
        styles ["suggested-action", "pill"]
        label: "Let's get started!";
        action-name: "win.start";
        //child: Adw.ButtonContent {
        //  label: "Let's get started";
        //};
      };
    };
  };
}


// Navigation pages for split-view content
Adw.NavigationPage password_viewer_navigation {
  child: Adw.NavigationView viewer_nav_view {
    Adw.NavigationPage {
      title: "Select a password";
      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          show-title: false;
          [end]
          Gtk.MenuButton {
            primary: true;
            icon-name: "open-menu-symbolic";
            tooltip-text: _("Menu");
            menu-model: primary_menu;
          }
        }
        content: Adw.StatusPage {
          title: "No password selected";
          description: "Select a password entry to edit";
        };
      };
    }
  };
}


// Navigation pages for split-view sidebar
// Mostly built in code - see window.build_navigation_page()
Adw.NavigationPage password_browser {
  child: Adw.NavigationView browser_nav_view {
  };
}


// Menus
menu primary_menu {
  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "win.show-help-overlay";
    }

    item {
      label: _("_About Identities");
      action: "app.about";
    }
  }
}
