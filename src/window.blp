using Gtk 4.0;
using Adw 1;

template $IdentitiesWindow : Adw.ApplicationWindow {
  title: "Identities";
  default-height: 450;
  default-width: 800;
  Adw.Breakpoint {
    condition ("max-width: 550sp")
    setters {
      splitview.collapsed: true;
    }
  }
  content: 
  Adw.ToolbarView toolbarview {
    [top]
    Adw.HeaderBar header_bar {
      Gtk.Button {
        icon-name: "go-previous-symbolic";
        tooltip-text: "Back";
        action-name: "win.back";
      }
      show-title: false;
      [end]
      Gtk.MenuButton {
        primary: true;
        icon-name: "open-menu-symbolic";
        tooltip-text: _("Menu");
        menu-model: primary_menu;
      }
    }
    content: welcome;
  };
}

Adw.NavigationSplitView splitview {
  //collapsed: false;
  //show-content: false;
  sidebar: password_list;
  content: empty_password;
}

Adw.NavigationPage empty_password {
  title: "Select a password";
  child: Adw.StatusPage {
    title: "No password selected";
    description: "Select a password entry to edit";
  };
}

Adw.NavigationPage password_page {
  title: "Password";
  child: Adw.StatusPage {
    child: Adw.Clamp {
      maximum-size: 450;
      child: Gtk.Box {
        orientation: vertical;
        spacing: 20;
        Adw.PreferencesGroup password_group {
          //title: "Password";
          //description: "./path/to/password";

          //header-suffix: Gtk.Button {
          //  Adw.ButtonContent {
          //    icon-name: "list-add-symbolic";
          //    label: "Add row";
          //  }
          //};

          //Adw.PasswordEntryRow {
          //  title: "Password";
          //  text: "AmazingPassword";
          //  editable: false;
          //}

          //Adw.ActionRow {
          //  subtitle: "login";
          //  title: "k8ie";
            // icon-name: "copy";
            // text: "k8ie";
            // editable: false;
          }

        Adw.Clamp {
          maximum-size: 300;
          child: Gtk.Button {
            styles ["suggested-action", "pill"]
            label: "Edit";
            action-name: "win.edit";
          };
        }
        };
      };
    };
  }

Adw.NavigationPage password_list {
  title: "Password list";
  child: Gtk.ScrolledWindow {
    child: Gtk.ListBox password_list_view {
      styles ["boxed-list"]
      //selection-mode: none;
    };
  };
}

Adw.StatusPage welcome {
  title: "Welcome to Identities!";
  description: "The standard unix password manager for GNOME";
  child: Adw.Clamp {
    maximum-size: 250;
    child: Gtk.Button start {
      styles ["suggested-action", "pill"]
      label: "Let's get started!";
      action-name: "win.start";
      //child: Adw.ButtonContent {
      //  label: "Let's get started";
      //};
    };
  };
}

menu primary_menu {
  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "win.show-help-overlay";
    }

    item {
      label: _("_About Identities");
      action: "app.about";
    }
  }
}
