<?xml version="1.0" encoding="utf-8"?>
<component type="desktop-application">
  <id>one.k8ie.Identities</id>
  <launchable type="desktop-id">one.k8ie.Identities.desktop</launchable>
  <name>Identities</name>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <content_rating type="oars-1.1"/>
  <developer id="one.k8ie">
    <name>Kateřina Medvědová</name>
    <url>https://k8ie.one/</url>
  </developer>
  <update_contact>k8ie_AT_mcld.eu</update_contact>
  <summary>Modern password-store client made for GNOME</summary>

  <description>
    <p>Features include:</p>
    <ul>
      <li>Adaptive UI - works great on phones and small screens</li>
      <li>Supports as many arbitrary attributes as you want</li>
      <li>Generates TOTPs (even several per file)</li>
      <li>Support for multiple password stores in arbitrary locations</li>
    </ul>
  </description>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
    <internet>offline-only</internet>
  </supports>

  <screenshots>
    <screenshot type="default">
      <image type="source">https://github.com/k8ieone/identities/raw/refs/heads/the-chosen-one/misc/screenshots/password.png</image>
      <caption>Viewing a password</caption>
    </screenshot>
    <screenshot>
      <image type="source">https://github.com/k8ieone/identities/raw/refs/heads/the-chosen-one/misc/screenshots/store_selection.png</image>
      <caption>Store selection</caption>
    </screenshot>
    <screenshot>
      <image type="source">https://github.com/k8ieone/identities/raw/refs/heads/the-chosen-one/misc/screenshots/mobile.png</image>
      <caption>Mobile view</caption>
    </screenshot>
  </screenshots>

  <url type="homepage">https://github.com/k8ieone/identities</url>
  <url type="bugtracker">https://github.com/k8ieone/identities/issues</url>
  <url type="donation">https://liberapay.com/k8ie</url>
  <url type="vcs-browser">https://github.com/k8ieone/identities</url>

</component>
